+// ==================== Lidar Functions ====================
+
+void RL_Sim::LoadMid360Pattern()
+{
+    this->mid360_rays.clear();
+    std::string pattern_path = std::string(POLICY_DIR) + "/g1/p3o_end2end/mid360_pattern_1024.csv";
+    std::ifstream file(pattern_path);
+    if (!file.is_open())
+    {
+        std::cout << LOGGER::WARNING << "Mid360 pattern file not found: " << pattern_path << " (lidar will output zeros)" << std::endl;
+        return;
+    }
+    std::string line;
+    while (std::getline(file, line))
+    {
+        std::stringstream ss(line);
+        std::string theta_str, phi_str;
+        if (std::getline(ss, theta_str, ',') && std::getline(ss, phi_str, ','))
+        {
+            this->mid360_rays.push_back({std::stof(theta_str), std::stof(phi_str)});
+        }
+    }
+    std::cout << LOGGER::INFO << "Loaded mid360 pattern: " << this->mid360_rays.size() << " rays" << std::endl;
+}
+
+void RL_Sim::LidarCallback(const livox_ros_driver2::msg::CustomMsg::SharedPtr msg)
+{
+    if (this->mid360_rays.empty()) return;
+
+    // sensor offset relative to pelvis (same as URDF mid360_link)
+    const float sensor_offset[3] = {0.10f, 0.0f, 0.63f};
+    const float max_distance = this->params.Get<float>("lidar_points_clip", 6.0f);
+    const float half_fov = static_cast<float>(M_PI) * 0.5f;
+
+    // build unordered point cloud from livox custom msg
+    // each point has (x,y,z) in sensor frame
+    std::vector<std::array<float,3>> raw_points;
+    raw_points.reserve(msg->point_num);
+    for (const auto& pt : msg->points)
+    {
+        raw_points.push_back({pt.x, pt.y, pt.z});
+    }
+
+    // match each mid360_ray to the closest raw point by direction
+    // then transform to body frame (relative to pelvis)
+    std::vector<LidarPoint3> points_base;
+    std::vector<bool> valid;
+    points_base.reserve(this->mid360_rays.size());
+    valid.reserve(this->mid360_rays.size());
+
+    for (const auto& ray : this->mid360_rays)
+    {
+        // ray direction in sensor frame (same convention as mujoco version)
+        float dir[3] = {
+            std::cos(ray.theta) * std::cos(ray.phi),
+            std::sin(ray.theta) * std::cos(ray.phi),
+            std::sin(ray.phi)
+        };
+
+        // find closest raw point by angular distance
+        float best_dist = max_distance;
+        float best_dot = -1.0f;
+        for (const auto& rp : raw_points)
+        {
+            float r_norm = std::sqrt(rp[0]*rp[0] + rp[1]*rp[1] + rp[2]*rp[2]);
+            if (r_norm < 0.01f) continue;
+            float dot = (dir[0]*rp[0] + dir[1]*rp[1] + dir[2]*rp[2]) / r_norm;
+            if (dot > best_dot)
+            {
+                best_dot = dot;
+                best_dist = r_norm;
+            }
+        }
+        best_dist = std::min(best_dist, max_distance);
+
+        // point in body frame (relative to pelvis, offset from sensor to pelvis)
+        LidarPoint3 pb = {
+            dir[0] * best_dist + sensor_offset[0],
+            dir[1] * best_dist + sensor_offset[1],
+            dir[2] * best_dist + sensor_offset[2]
+        };
+
+        float planar_range = std::sqrt(std::max(pb.x * pb.x + pb.y * pb.y, 1.0e-9f));
+        float theta = std::atan2(pb.y, pb.x);
+        bool point_valid =
+            pb.x >= -0.5f && pb.x <= 6.0f &&
+            std::abs(pb.y) <= 3.0f &&
+            pb.z >= -1.0f && pb.z <= 0.8f &&
+            planar_range >= 0.2f && planar_range <= max_distance &&
+            std::abs(theta) <= half_fov;
+
+        points_base.push_back(pb);
+        valid.push_back(point_valid);
+    }
+
+    // FPS sample down to num_points
+    int num_points = this->params.Get<int>("lidar_num_points", 128);
+    auto sampled = this->FpsSampleLidar(points_base, valid, num_points);
+
+    {
+        std::lock_guard<std::mutex> lock(this->lidar_mutex);
+        this->latest_lidar_points_base = std::move(sampled);
+        this->lidar_received = true;
+    }
+}
+
+std::vector<RL_Sim::LidarPoint3> RL_Sim::FpsSampleLidar(const std::vector<LidarPoint3>& points, const std::vector<bool>& valid, int num_samples)
+{
+    std::vector<LidarPoint3> sampled(num_samples, {0.0f, 0.0f, 0.0f});
+    int valid_count = 0;
+    for (bool is_valid : valid) { if (is_valid) valid_count++; }
+    if (points.empty() || valid_count == 0 || num_samples <= 0) return sampled;
+
+    // find seed: closest valid point
+    float best_range = std::numeric_limits<float>::infinity();
+    int current_idx = 0;
+    for (size_t i = 0; i < points.size(); ++i)
+    {
+        if (!valid[i]) continue;
+        float range_sq = points[i].x * points[i].x + points[i].y * points[i].y + points[i].z * points[i].z;
+        if (range_sq < best_range)
+        {
+            best_range = range_sq;
+            current_idx = static_cast<int>(i);
+        }
+    }
+
+    // greedy FPS
+    std::vector<float> min_dist(points.size(), std::numeric_limits<float>::infinity());
+    std::vector<int> selected;
+    selected.reserve(num_samples);
+
+    for (int s = 0; s < num_samples; ++s)
+    {
+        if (s < static_cast<int>(selected.size()) || s == 0)
+        {
+            selected.push_back(current_idx);
+            sampled[s] = points[current_idx];
+        }
+
+        float cx = points[current_idx].x, cy = points[current_idx].y, cz = points[current_idx].z;
+        for (size_t j = 0; j < points.size(); ++j)
+        {
+            if (!valid[j]) continue;
+            float dx = points[j].x - cx, dy = points[j].y - cy, dz = points[j].z - cz;
+            float d2 = dx*dx + dy*dy + dz*dz;
+            if (d2 < min_dist[j]) min_dist[j] = d2;
+        }
+
+        // pick next: valid point with max min_dist
+        float max_min_dist = -1.0f;
+        int next_idx = current_idx;
+        for (size_t j = 0; j < points.size(); ++j)
+        {
+            if (!valid[j]) continue;
+            bool already_selected = false;
+            for (int sel : selected) { if (static_cast<size_t>(sel) == j) { already_selected = true; break; } }
+            if (already_selected) continue;
+            if (min_dist[j] > max_min_dist)
+            {
+                max_min_dist = min_dist[j];
+                next_idx = static_cast<int>(j);
+            }
+        }
+        current_idx = next_idx;
+    }
+    return sampled;
+}
